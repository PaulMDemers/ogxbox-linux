#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/sbin:/usr/local/bin

STATUS_FILE=/root/xbox-remount-status.txt
echo "syncing filesystems"
printf 'XBOX_REMOUNT_STATUS=OK_____\n' > "$STATUS_FILE"
sync
echo "remounting / read-only"
ROOT_DEV="$(awk '$2 == "/" { print $1; exit }' /proc/mounts 2>/dev/null)"
echo "root device: ${ROOT_DEV:-unknown}"
awk '$2 == "/" { print "root mount: " $0; exit }' /proc/mounts 2>/dev/null || true
if [ -n "$ROOT_DEV" ]; then
    loop_name="${ROOT_DEV##*/}"
    [ -r "/sys/block/$loop_name/loop/backing_file" ] && {
        echo -n "loop backing file: "
        cat "/sys/block/$loop_name/loop/backing_file"
    }
    [ -r "/sys/block/$loop_name/ro" ] && {
        echo -n "loop read-only flag: "
        cat "/sys/block/$loop_name/ro"
    }
fi
root_is_read_only() {
    while IFS=' ' read -r _device mountpoint _type options _rest; do
        [ "$mountpoint" = "/" ] || continue
        case ",$options," in
            *,ro,*) return 0 ;;
        esac
        return 1
    done < /proc/mounts
    return 1
}
writable_descriptors() {
    echo "writable file descriptors before remount:"
    found=0
    for info in /proc/[0-9]*/fdinfo/[0-9]*; do
        [ -r "$info" ] || continue
        flags="$(awk '$1 == "flags:" { print $2; exit }' "$info" 2>/dev/null)"
        last_digit="${flags#${flags%?}}"
        case "$last_digit" in
            1|2|3|5|6|7) ;;
            *) continue ;;
        esac
        fd="${info%/fdinfo/*}/fd/${info##*/}"
        target="$(readlink "$fd" 2>/dev/null || true)"
        echo "  $fd flags=$flags target=$target"
        found=1
    done
    [ "$found" = "1" ] || echo "  none"
}
writable_descriptors
attempt=1
while [ "$attempt" -le 5 ]; do
    echo "read-only remount attempt $attempt"
    if [ -n "$ROOT_DEV" ] && [ -x /bin/busybox ]; then
        if [ "$attempt" = "1" ]; then
            remount_output="$(/bin/busybox mount -n -o remount,ro "$ROOT_DEV" / 2>&1)"
        else
            remount_output="$(/bin/busybox mount -n -o remount,ro / 2>&1)"
        fi
        remount_status=$?
    elif [ -n "$ROOT_DEV" ]; then
        remount_output="$(mount -n -o remount,ro "$ROOT_DEV" / 2>&1)"
        remount_status=$?
    else
        remount_output="$(mount -n -o remount,ro / 2>&1)"
        remount_status=$?
    fi
    echo "remount status: $remount_status"
    [ -n "$remount_output" ] && echo "remount output: $remount_output"
    if root_is_read_only; then
        sync
        echo "XBOX_ROOT_REMOUNT_RO_OK"
        case "${XBOX_SMOKE_PHASE:-INCOMPLETE}" in
            FIRST_BOOT_WRITE_OK)
                echo "XBOX_HARDWARE_SMOKE_FIRST_BOOT_PASS"
                ;;
            SECOND_BOOT_PERSISTENCE_OK)
                echo "XBOX_HARDWARE_SMOKE_SECOND_BOOT_PASS"
                ;;
            *)
                echo "XBOX_HARDWARE_SMOKE_PERSISTENCE_INCOMPLETE phase=${XBOX_SMOKE_PHASE:-INCOMPLETE}"
                ;;
        esac
        echo "It is now safer to power off or reset."
        while :; do sleep 3600; done
    fi
    sync
    sleep 2
    attempt=$((attempt + 1))
done

echo "XBOX_ROOT_REMOUNT_RO_FAILED"
printf 'XBOX_REMOUNT_STATUS=FAILED_\n' > "$STATUS_FILE"
sync
echo "Some process may still have writable files open. Run sync again before power-off."
while :; do sleep 3600; done
